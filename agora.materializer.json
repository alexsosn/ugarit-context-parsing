{
  "schema_version": 1,
  "plugin": {
    "id": "ugarit-context-parsing",
    "name": "Ugarit Context Parsing",
    "version": "0.2.0",
    "repository": "alexsosn/ugarit-context-parsing"
  },
  "materializers": [
    {
      "id": "burns-workbooks-csv-text-fabric",
      "description": "Convert local Burns Workbooks CSV files into a CUC-aligned Text-Fabric contextual corpus.",
      "acquisition": [
        {
          "type": "user-local",
          "path_type": "directory",
          "prompt": "Select the directory containing generated Burns Workbook CSV files"
        }
      ],
      "input": {
        "type": "directory",
        "required_globs": [
          "*/*.csv"
        ],
        "allow_symlinks": false
      },
      "execution": {
        "type": "python-module",
        "module": "ugarit_context_parsing.cli",
        "args": [
          "convert",
          "{source}",
          "--input-format",
          "csv",
          "--output",
          "{output}"
        ],
        "network": "deny"
      },
      "output": {
        "format": "text-fabric",
        "required_paths": [
          "otype.tf",
          "oslots.tf",
          "otext.tf",
          "conversion-report.json"
        ]
      }
    },
    {
      "id": "burns-workbooks-pdf-text-fabric",
      "description": "Parse local Burns Workbook PDFs and convert the extracted contextual rows into the same CUC-aligned Text-Fabric corpus.",
      "acquisition": [
        {
          "type": "user-local",
          "path_type": "directory",
          "prompt": "Select the directory containing the Burns Workbook PDF subdirectories"
        }
      ],
      "input": {
        "type": "directory",
        "required_globs": [
          "*/*.pdf"
        ],
        "allow_symlinks": false
      },
      "execution": {
        "type": "python-module",
        "module": "ugarit_context_parsing.cli",
        "args": [
          "convert",
          "{source}",
          "--input-format",
          "pdf",
          "--output",
          "{output}"
        ],
        "network": "deny"
      },
      "output": {
        "format": "text-fabric",
        "required_paths": [
          "otype.tf",
          "oslots.tf",
          "otext.tf",
          "conversion-report.json"
        ]
      }
    }
  ]
}
